#!/usr/bin/env bash
set -euo pipefail

STORAGE_ACCOUNT="${storage_account}"
CONTAINER_NAME="${container_name}"
MOUNT_POINT="/home/analyst/data"

# Install blobfuse2 and fuse3 using your distribution's supported
# BlobFuse2 installation instructions before running this script.
command -v blobfuse2 >/dev/null || {
  echo "blobfuse2 is not installed" >&2
  exit 1
}

echo "wait for cloud-init to finish"
# wait for cloud init to complete 
# it can have exit code of 0 or 2 to indicate success  
# https://docs.cloud-init.io/en/latest/explanation/failure_states.html#cloud-init-error-codes
if cloud-init status --wait; then
  :
else
  rc=$?
  if (( rc == 2 )); then
    echo "cloud-init completed with recoverable errors"
  else
    exit "$rc"
  fi
fi

echo "create directories"
install -d -m 0755 "$MOUNT_POINT"
install -d -m 0755 /etc/blobfuse2

echo "create blobfuse2 log files"
# blobfuse2 doesn't create this itself
touch /var/log/blobfuse2.log

echo "create blobfuse2 config - forge.yaml"
cat >/etc/blobfuse2/forge.yaml <<YAML
allow-other: true

components:
  - libfuse
  - stream
  - attr_cache
  - azstorage

libfuse:
  direct-io: true
  attribute-expiration-sec: 0
  entry-expiration-sec: 0
  negative-entry-expiration-sec: 0

attr_cache:
  timeout-sec: 0

azstorage:
  type: block
  account-name: $${STORAGE_ACCOUNT}
  container:  $${CONTAINER_NAME}
  endpoint: https://$${STORAGE_ACCOUNT}.blob.core.windows.net
  mode: msi
YAML

chmod 0600 /etc/blobfuse2/forge.yaml

echo "Create fstab entry"
# Keep the entry idempotent if the extension is rerun.
grep -qF '/mnt/blob-sde-forge-share fuse3' /etc/fstab || \
  echo 'blobfuse2 /home/analyst/data fuse3 defaults,_netdev,--config-file=/etc/blobfuse2/forge.yaml,--streaming 0 0' >> /etc/fstab

echo "Mount the data share"

for i in $(seq 1 5); do
  # check if appears mounted, and we can see files
  if mountpoint -q "$MOUNT_POINT" && ls "$MOUNT_POINT" > /dev/null 2>&1; then
    echo "Mounted and accessible!"
    SUCCESS=true
    break
  fi
  # 2. If not mounted, try to mount it
  echo "Attempt $i: Trying to mount '$MOUNT_POINT'..."
  if mount "$MOUNT_POINT"; then
    echo "Mount successful!"
    SUCCESS=true
    break
  fi

  echo "Mount failed. Waiting 30s..."
  sleep 30
done;
